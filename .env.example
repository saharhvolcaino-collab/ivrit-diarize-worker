# Copy this file to .env and fill in real values.
# .env is gitignored - the key never enters version control.

# RunPod API key. Console -> Settings -> API Keys -> Create API Key.
# Needs write access to create and call endpoints.
RUNPOD_API_KEY=

# Filled in after the endpoint is deployed.
RUNPOD_ENDPOINT_ID=

# Optional. Only needed if we end up using a gated pyannote model for the
# diarization comparison. The ivrit-ai mirrors are ungated, so this may stay empty.
HF_TOKEN=
